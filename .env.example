# Copy to .env and edit. Never commit .env.

ENV=dev
LOG_LEVEL=INFO

# --- OCR ----------------------------------------------------------------------
# Windows needs the full path; on Linux/Mac leave blank if tesseract is on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# "eng", "hin", or "eng+hin" for the mixed-script documents normal in Indian clinics.
# Requires the matching tesseract language pack installed.
OCR_LANGUAGES=eng

PDF_DPI=200
MAX_PAGES=10
MIN_WORD_CONFIDENCE=0.35

# --- optional vision model ----------------------------------------------------
# Leave EMPTY for the offline path, which must always work. Setting this only
# improves handwriting accuracy; it must never be required. Anthropic is tried
# first if both keys are set; Gemini otherwise. This repo has actually been run
# with a Gemini key, not Anthropic.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VISION_FALLBACK_THRESHOLD=0.55

# --- terminology --------------------------------------------------------------
# Fuzzy-match cutoff. Deliberately strict: a wrong LOINC code is worse than no code.
TERM_MATCH_THRESHOLD=0.86

# --- Bhashini (Module A speech) ------------------------------------------
# From the Udyat dashboard: dashboard.bhashini.co.in/bhashini-Udyat -> API Keys
# -> the INFERENCE row. NOT the Udyat key, and there is no user ID in that flow.
# Test it:  python ml/scripts/test_bhashini.py
# Turn DATA TRACKING OFF on the dashboard — our payloads are patient speech.
BHASHINI_INFERENCE_KEY=
